# Local settings example. Copy to .env; never commit real credentials.
PORT=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_use_a_long_unique_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=JalSuraksha Dam Flood Warning Center

FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Required for persistent Vercel deployments. Configure in Vercel, not frontend code.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
